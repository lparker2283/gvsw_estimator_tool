# ---- Brain -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---- Transcription -----------------------------------------------------
# Groq is the default: OpenAI-compatible endpoint, whisper-large-v3-turbo.
GROQ_API_KEY=gsk_...
TRANSCRIBE_PROVIDER=groq          # groq | openai | deepgram
OPENAI_API_KEY=                   # only if TRANSCRIBE_PROVIDER=openai
DEEPGRAM_API_KEY=                 # only if TRANSCRIBE_PROVIDER=deepgram

# ---- Mail (inbound + outbound) ----------------------------------------
# All mail lives on the mail.dogruntwork.com subdomain: Resend free tier allows
# ONE custom domain, and a subdomain also isolates this tool's sending reputation
# from the Google Workspace mail on the root domain. Inbound accepts ANY address
# at that subdomain -- route on the local part, or just classify from the memo.
RESEND_API_KEY=re_...
RESEND_INBOUND_SECRET=            # signing secret for the inbound webhook
MAIL_FROM="GVSW Estimator <estimates@mail.dogruntwork.com>"
DAN_EMAIL=dan@geneseevalleystoneworks.com
CC_EMAIL=                         # optional: your address, for the human-in-loop phase

# ---- State -------------------------------------------------------------
SUPABASE_URL=https://hvaqvnpvcnwgvfbhgbze.supabase.co   # project: gvsw_estimator_tool
SUPABASE_SERVICE_ROLE_KEY=

# ---- Drive (feeds the reMarkable) --------------------------------------
# KEYLESS AUTH. The dogruntwork.com GCP org enforces
# iam.managed.disableServiceAccountKeyCreation, so downloadable service account
# keys cannot be created — correct, and we work with it rather than around it.
# Vercel mints a short-lived OIDC token per request; GCP exchanges it for
# credentials that impersonate the service account. No long-lived secret exists.
GCP_PROJECT_ID=gvsw-estimator-dgw
GCP_PROJECT_NUMBER=396050840439           # confirmed from IAM & Admin -> Settings
GCP_SERVICE_ACCOUNT_EMAIL=gvsw-estimator@gvsw-estimator-dgw.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

GOOGLE_SERVICE_ACCOUNT_JSON=      # LOCAL DEV ONLY, and only if a key is permitted.
                                  # Leave blank in production — presence of this
                                  # var makes lib/drive.ts prefer the key path.

DRIVE_FOLDER_ID=19YrrwEvLmXuyr2V0SOoD1EwSSCvleu9B   # "GVSW Estimates" — owned by lindsey@dogruntwork.com

# ---- App ---------------------------------------------------------------
APP_URL=https://estimator.dogruntwork.com
LINK_SIGNING_SECRET=              # any long random string
MAX_QUESTIONS=5
HUMAN_IN_THE_LOOP=true            # true = documents go to CC_EMAIL for review before Dan
