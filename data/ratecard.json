  "integrity_specs": [
    {
      "id": "frost_line",
      "applies_to": [
        "flatwork",
        "steps",
        "patio",
        "foundation"
      ],
      "statement": "Sub-base must sit 12\" or more below the frost line — 48\" in Monroe County.",
      "rationale": "Frost heave is the leading cause of flatwork failure in Rochester."
    },
    {
      "id": "freeze_thaw_cycles",
      "applies_to": [
        "stone",
        "chimney",
        "brick",
        "tile"
      ],
      "statement": "Rochester sees 100+ freeze-thaw cycles per year.",
      "rationale": "Freeze-thaw is the #1 cause of stone deterioration locally; inspect and seal annually."
    },
    {
      "id": "wall_drainage",
      "applies_to": [
        "retaining_wall"
      ],
      "statement": "Crushed stone backfill, filter fabric, and weep holes are required on any wall rebuild.",
      "rationale": "Drainage failure is the #1 cause of wall collapse."
    },
    {
      "id": "water_contact_mortar",
      "applies_to": [
        "water_features",
        "chimney_crown"
      ],
      "statement": "Hydraulic cement and waterproofing mortar admix are required on water-contact surfaces. Standard Type S will not hold.",
      "rationale": "Type S fails under sustained water contact."
    },
    {
      "id": "exterior_tile_thinset",
      "applies_to": [
        "tile_exterior"
      ],
      "statement": "Frost-rated tile and polymer-modified thinset are required on exterior tile.",
      "rationale": "Standard thinset will not survive Rochester freeze-thaw cycles."
    },
    {
      "id": "historic_mortar",
      "applies_to": [
        "brick",
        "chimney",
        "stone"
      ],
      "condition": "structure built pre-1930",
      "statement": "Type N or NHL lime mortar is required on pre-1930 masonry.",
      "rationale": "Portland-based mortar is too hard and causes face spalling on historic soft brick."
    }
  ],
